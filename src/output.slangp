# One-pass preset around output.slang (see there): turns the user's preset's SDR output
# into the HDR swap chain's format. The add-on renders it into a texture the size of the
# game picture's rectangle, in the frame's format.
shaders = 1
shader0 = "output.slang"
filter_linear0 = false
scale_type0 = viewport
scale0 = 1.0
